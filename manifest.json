{
  "manifest_version": 3,
  "name": "Quiet",
  "version": "0.9.0",
  "description": "Blocks ads and trackers, calmly. An ad blocker with the temperament of a guided meditation that has read the privacy policy.",
  "homepage_url": "https://github.com/hrmau/quiet-ad-blocker",
  "permissions": [
    "declarativeNetRequest",
    "webRequest",
    "storage",
    "webNavigation",
    "alarms",
    "favicon",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Quiet",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/ads.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}
